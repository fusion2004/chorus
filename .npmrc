# Only npm reads this; yarn (the package manager here) ignores it.
#
# The Railway config workflow's plan step runs `npm install` just so .railway/railway.ts can import railway/iac. npm
# ignores yarn's `resolutions`, so it would build @eyevinn/srt with the node-gyp that breaks on Python 3.13 (#1105).
# Nothing native is needed to evaluate config, so skip install scripts.
ignore-scripts=true
